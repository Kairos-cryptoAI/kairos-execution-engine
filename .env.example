KAIROS_EXCHANGE=evedex
KAIROS_TRADING_MODE=DRY_RUN
# Deprecated input: only `true` is accepted for compatibility. `false` is a startup error.
# KAIROS_DRY_RUN=true
KAIROS_ACCOUNT_ID=primary
KAIROS_ACCOUNT_SNAPSHOT_INTERVAL_S=15
KAIROS_DRY_RUN_EQUITY_USD=10000
KAIROS_EVEDEX_PROFILE=DEV
KAIROS_EVEDEX_EXCHANGE_URL=https://trading-api.evedex.tech
KAIROS_EVEDEX_AUTH_URL=https://auth-api.evedex.tech
KAIROS_EVEDEX_WEBSOCKET_URL=wss://ws.evedex.tech/connection/websocket
KAIROS_EVEDEX_WEBSOCKET_PREFIX=futures-perp-dev
KAIROS_EVEDEX_CHAIN_ID=16182
KAIROS_EVEDEX_JWT=
KAIROS_EVEDEX_PRIVATE_KEY=
KAIROS_EVEDEX_SYMBOL_MAP={"BTCUSDT":"BTCUSD","ETHUSDT":"ETHUSD","SOLUSDT":"SOLUSD","BNBUSDT":"BNBUSD","XRPUSDT":"XRPUSD"}
KAIROS_EVEDEX_DEV_SYMBOL_MAP={"BTCUSDT":"BTCUSD:DEV","ETHUSDT":"ETHUSD:DEV","SOLUSDT":"SOLUSD:DEV","BNBUSDT":"BNBUSD:DEV","XRPUSDT":"XRPUSD:DEV"}
# PAPER-only secret *paths*. Values stay in separate Compose/Docker secret files.
# KAIROS_EVEDEX_DEV_API_KEY_FILE=/run/secrets/evedex_dev_api_key
# KAIROS_EVEDEX_DEV_PRIVATE_KEY_FILE=/run/secrets/evedex_dev_private_key
# KAIROS_EVEDEX_DEV_EXPECTED_ACCOUNT_ID=kairos-paper-dev-account
# Independent, non-secret, read-only scope JSON required ONLY for new bounded DEV entries.
# Missing/invalid scope keeps recovery and protective exits available; never enables entry.
# KAIROS_CANARY_SCOPE_FILE=/run/config/canary-scope.json
KAIROS_DEFAULT_TRAIL_PCT=0.01
KAIROS_IDEMPOTENCY_CACHE_SIZE=10000
# CCXT (for testing on other venues)
KAIROS_CCXT_EXCHANGE_ID=binanceusdm
KAIROS_CCXT_SANDBOX=true
